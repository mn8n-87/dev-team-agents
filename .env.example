# Pick one LLM provider and set its key
ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# Model to use across all agents (change to openai/gpt-4o if using OpenAI)
AGENT_MODEL=anthropic/claude-sonnet-4-20250514

# Conductor server (default: local dev server started by `agentspan server start`)
CONDUCTOR_SERVER_URL=http://localhost:6767/api
