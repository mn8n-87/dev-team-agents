# LLM calls run on the Agentspan server, so the provider key must be set on the
# server (e.g. `docker run ... -e ANTHROPIC_API_KEY=...`), not only here.
ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# Model to use across all agents (change to openai/gpt-4o if using OpenAI)
AGENT_MODEL=anthropic/claude-sonnet-5-5

# Agentspan server (the agentspan Docker container listens on port 6767)
CONDUCTOR_SERVER_URL=http://localhost:6767/api

# Project the team works on (default: the current directory)
# AGENT_WORKDIR=/path/to/your/project
